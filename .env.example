# ================================================================================
#  I-SCEET — Environment Variables Template
#  Copy this file to .env and fill in your values
#  NEVER commit .env to GitHub
# ================================================================================

# Required: public URL of your Colab inference server
# (e.g. your reserved ngrok domain, see dashboard.ngrok.com → Domains)
COLAB_URL=

# Optional: SQLite database path (absolute, or relative to the repo root).
# Default: isceet.db at the repo root.
# DB_PATH=/path/to/your/isceet.db
